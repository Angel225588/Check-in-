node_modules/
.next/
out/
# The repository is public and holds a real Gemini key's blast radius. Ignore
# every .env shape rather than the two we happened to think of — .env.production
# and .env.development.local are one `git add -A` away from being public.
.env*
!.env.sample
*.tsbuildinfo
next-env.d.ts
validation-artifacts/

# throwaway measurement/probe scripts written during design evaluation runs
# (kept out of history; real tools live in scripts/ without the dot). The
# scripts/ patterns are here because that is where they actually get written —
# a probe needs to sit beside the harness to resolve the same browser.
/_*.mjs
/.probe-*.mjs
/.probe-*.js
scripts/.*.mjs
scripts/.*.js
