# Mistral AI — EU-hosted (Paris). The ONLY cloud AI provider guest PII is sent
# to, which is what keeps the RGPD position simple for French hotel customers.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional overrides. Model ids are pinned deliberately (not "-latest"):
# Mistral retires versioned models on a schedule, and a silently-moving alias
# is how a working pipeline breaks overnight with no code change.
# MISTRAL_OCR_MODEL=mistral-ocr-4-1
# MISTRAL_CHAT_MODEL=mistral-large-2512
# MISTRAL_OCR_TIMEOUT_MS=90000
# MISTRAL_CHAT_TIMEOUT_MS=60000
# MISTRAL_MAX_RETRIES=3
# MISTRAL_MAX_OUTPUT_TOKENS=16384
# MISTRAL_MAX_INPUT_CHARS=480000

# Supabase — imarketin project (eu-west-3 Paris). Anon/publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Sync engine feature flag. OFF by default — localStorage stays the source of truth
# until multi-device sync is proven (zero data loss). Flip to true only on a test device.
NEXT_PUBLIC_SYNC_ENABLED=false
