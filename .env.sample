# Mistral AI — EU-hosted (Paris). The ONLY cloud AI provider guest PII is sent
# to, which is what keeps the RGPD position simple for French hotel customers.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional overrides. Model ids are pinned deliberately (not "-latest"):
# Mistral retires versioned models on a schedule, so a moving alias is a silent
# outage waiting to happen. Verified against GET /v1/models.
# MISTRAL_OCR_MODEL=mistral-ocr-4-1
# MISTRAL_CHAT_MODEL=mistral-large-2512
# MISTRAL_MAX_RETRIES=3
# MISTRAL_MAX_OUTPUT_TOKENS=16384

# Server-side only. Never prefixed NEXT_PUBLIC_ — that would inline the key
# into the JavaScript every tablet downloads. The OCR routes read it on the
# server and the browser never sees it.

# Ships the demo loader and /debug. Set it for local work and for the two
# harnesses that click through the app's own demo data; leave it unset
# everywhere reception can reach. A production deployment refuses the tools
# even if this is set — see src/lib/test-tools.ts.
# NEXT_PUBLIC_TEST_TOOLS=1

# Retention window for guest data, in days.
# Default 90. Recommended production value: 30 (see docs/GDPR-AUDIT.md §3).
NEXT_PUBLIC_RETENTION_DAYS=30

# Required in production — the API refuses to serve without it.
API_AUTH_TOKEN=your_api_auth_token_here
