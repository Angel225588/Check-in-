# Mistral AI — EU-hosted (Paris). The ONLY cloud AI provider guest PII is sent
# to, which is what keeps the RGPD position simple for French hotel customers.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional overrides. Model ids are pinned deliberately (not "-latest"):
# Mistral retires versioned models on a schedule, so a moving alias is a silent
# outage waiting to happen. Verified against GET /v1/models.
# MISTRAL_OCR_MODEL=mistral-ocr-4-1
# MISTRAL_CHAT_MODEL=mistral-large-2512
# MISTRAL_MAX_RETRIES=3
# MISTRAL_MAX_OUTPUT_TOKENS=16384

# Server-side only. Never prefixed NEXT_PUBLIC_ — that would inline the key
# into the JavaScript every tablet downloads. The OCR routes read it on the
# server and the browser never sees it.

# Ships the demo loader and /debug. Set it for local work and for the two
# harnesses that click through the app's own demo data; leave it unset
# everywhere reception can reach. A production deployment refuses the tools
# even if this is set — see src/lib/test-tools.ts.
# NEXT_PUBLIC_TEST_TOOLS=1

# Retention window for guest data, in days.
# Default 90. Recommended production value: 30 (see docs/GDPR-AUDIT.md §3).
NEXT_PUBLIC_RETENTION_DAYS=30

# OPTIONAL, and only for server-to-server callers that can hold a secret.
#
# It was labelled "required in production" here, which is wrong twice over: the
# API does not refuse to serve without it, and setting it used to 401 every
# upload, because the reception tablet's browser sends no Authorization header.
# A token is now ADDITIVE — offered-and-wrong is rejected, not offered at all
# falls through to the same-origin check — so setting it cannot take the app
# down. It also cannot lock the browser API down; that is Supabase Auth's job
# (docs/GDPR-AUDIT.md §2). Leave it unset unless a script needs to call the API.
# API_AUTH_TOKEN=

# ── Metering identity ────────────────────────────────────────────────────────
# HMAC key for the device cookie that keys rate limits and the spend cap.
# Min 16 chars: openssl rand -hex 32
#
# SET THIS. Unset does not block anyone — the middleware mints a fresh cookie
# rather than refusing — but each serverless instance then signs with its own
# random key, so a tablet's identity changes as it is routed between instances.
# Per-device rate limits and per-property spend both stop being meaningful.
# This is NOT authentication. See src/lib/security/identity.ts.
SESSION_SECRET=

# ── AI spend cap (fails closed) ──────────────────────────────────────────────
# Estimated USD per calendar month. Reaching either cap returns 402.
AI_MONTHLY_BUDGET_USD=50
AI_MONTHLY_BUDGET_PER_PROPERTY_USD=25

# Billing and tenancy scope for this deployment.
PROPERTY_CODE=default

# Price estimates used for budgeting only — NOT a billing record. Mistral bills
# OCR per page and chat per token. Reconcile against the Mistral console.
# AI_PRICE_OCR_PER_PAGE_USD=0.001
# AI_PRICE_CHAT_INPUT_PER_MTOK_USD=2.0
# AI_PRICE_CHAT_OUTPUT_PER_MTOK_USD=6.0

# Where the spend ledger lives. "memory" (default) counts per instance, so on
# serverless the real ceiling is (cap x instances). Set "supabase" and apply the
# ai_spend table in supabase/schema.sql for a cap that actually holds.
# BUDGET_STORE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Rollout lever ────────────────────────────────────────────────────────────
# "enforce" (default) or "observe". In observe, rate limits, the spend cap and
# magic-byte validation all run and log what they WOULD reject, and reject
# nothing. Structural gates (method, same-origin, unknown path, declared size)
# stay on in both — they are not new behaviour.
#
# Ship a new limit in observe, read a day of logs, then enforce. Note that a
# month spent in observe leaves the spend ledger understating real spend.
# SECURITY_MODE=observe
